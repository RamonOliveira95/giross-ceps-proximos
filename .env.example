# Server
PORT=3000
NODE_ENV=development

# Docker
DOCKER_API_PORT=3001

# TTLs de cache, em segundos (justificativa no README)
GEOCODE_CACHE_TTL_SECONDS=604800
NEARBY_CACHE_TTL_SECONDS=86400
NOT_FOUND_CACHE_TTL_SECONDS=600

# Raio de busca, em metros
NEARBY_SEARCH_RADIUS_METERS=1000

# Rate limiting das APIs externas (intervalo minimo entre chamadas, em ms)
NOMINATIM_MIN_INTERVAL_MS=1100
OVERPASS_MIN_INTERVAL_MS=1000

# Rate limiting da propria API (requisicoes por IP por minuto em /ceps-proximos)
API_RATE_LIMIT_PER_MINUTE=60
# Se a API roda atras de proxy/load balancer, informe quantos (ex: 1) para o limite usar o IP real do cliente
# TRUST_PROXY_HOPS=1

# Se definido, DELETE /cache exige o header x-admin-token (se vazio, fica aberto).
# Gere um segredo forte com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_TOKEN=

# User-Agent exigido pela politica de uso do Nominatim/Overpass (coloque um contato real)
NOMINATIM_USER_AGENT=giross-ceps-proximos/1.0 (defina-um-contato-real@seudominio.com)

# APIs externas
BRASILAPI_BASE_URL=https://brasilapi.com.br/api
VIACEP_BASE_URL=https://viacep.com.br/ws
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Mirrors do Overpass separados por virgula (tentados em ordem; o ultimo que respondeu vai primeiro)
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter
# Timeout de cada tentativa (ms)
OVERPASS_TIMEOUT_MS=60000
# Rodadas pelos mirrors, com backoff exponencial entre elas (o Overpass publico responde 502/504 quando lotado)
OVERPASS_MAX_ROUNDS=3
OVERPASS_BACKOFF_MS=2000
# Orcamento total de tempo para obter a resposta do Overpass (ms)
OVERPASS_TOTAL_BUDGET_MS=150000
# Consultas simultaneas ao Overpass
OVERPASS_MAX_CONCURRENT=2

# Redis (opcional - se definido, o cache passa a usar Redis em vez de memoria)
REDIS_URL=redis://localhost:6379
